# M365Management — local development credentials
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must NEVER be committed.
#
# For CI/CD (GitHub Actions), set these as GitHub Actions secrets in the
# relevant GitHub Environment (Repo → Settings → Environments → <tenant>).
# OIDC / Workload Identity Federation is recommended over client secrets —
# see docs/authentication.md for setup instructions.

# Entra tenant ID (GUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
AZURE_TENANT_ID=

# App Registration client ID (GUID format)
AZURE_CLIENT_ID=

# Client secret — only needed when OIDC is not configured (leave blank for OIDC)
AZURE_CLIENT_SECRET=

# Set to 'true' to use OIDC / Workload Identity Federation instead of client secret.
# Requires federated credentials to be configured in the Entra App Registration.
USE_OIDC=false
